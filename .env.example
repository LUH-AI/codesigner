# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Optional, defaults shown.
#DEBUG=True
#ALLOWED_HOSTS=localhost,127.0.0.1
#DATABASE_URL=sqlite:///db.sqlite3

# Allow uploading model .py files that are executed to run experiments.
# This is arbitrary code execution — set to False on any shared/public host.
#ALLOW_CUSTOM_MODELS=True
