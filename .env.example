# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Optional, defaults shown.
#DEBUG=True
#ALLOWED_HOSTS=localhost,127.0.0.1
#DATABASE_URL=sqlite:///db.sqlite3

# Whether this instance has accounts. Off means no login and no per-user
# anything, which is what a local or private-network install wants. On, every
# page requires a signed-in user; create them with `manage.py createsuperuser`
# and the admin. See the README's hosting section.
#REQUIRE_LOGIN=False

# Turn on only once a TLS-terminating reverse proxy sits in front of this
# instance — it then redirects to HTTPS and marks cookies secure-only, which
# breaks a plain-HTTP setup (like the reference docker-compose.yml) outright.
#SECURE_BEHIND_TLS=False

# Allow uploading model .py files that are executed to run experiments.
# This is arbitrary code execution — set to False on any shared/public host.
#ALLOW_CUSTOM_MODELS=True

# Largest dataset, model .py, or .ihpo a browser may upload, in bytes.
#MAX_UPLOAD_BYTES=104857600

# Budget for the hyperparameter-importance analytics computed when a run
# finishes, in coalition evaluations (2^hyperparameters x 3 games x metrics).
# Past it they are skipped, and the experiment page says so. Cost is 15-19ms per
# coalition and exponential in hyperparameter count (independent of trial
# count): over 4 metrics, 4 hyperparameters is 3.6s, 6 is 12.7s, 8 is 45.6s,
# and 10 would be around 3 minutes.
# The default admits both built-in models; raise it if you tune wider models and
# accept the wait, or set 0 for no limit.
#ANALYTICS_EAGER_MAX_COALITIONS=1024

# ── Model environments ───────────────────────────────────────────────────────
# Uploaded models run in environments built by uv. Without uv they are imported
# into the application's own environment instead (and a hosted instance refuses).
#UV_BIN=uv
# Resolve only from uv's cache, and refuse to fetch an interpreter. Both belong
# on for an air-gapped or locked-down deployment.
#MODEL_ENV_OFFLINE=False
#MODEL_ENV_PYTHON_DOWNLOADS=True
# Seconds. Building an environment can mean a large download.
#MODEL_ENV_PREPARE_TIMEOUT=900
# Seconds a single trial may take before its model is presumed wedged.
#MODEL_TRIAL_TIMEOUT=600

# ── Where things live (the deployment configuration) ─────────────────────────
# Three switches decide whether the web process and the consumer can be on
# different machines. All three default to a file, which is one machine.
#
#   A. all-in-one   leave all three unset                       (development)
#   B. local web, cluster runs   as A, plus RUN_BACKEND=slurm below
#   C. hosted       set all three; see docker-compose.hosted.yml
#
# The queue. A file is shared by sharing a filesystem; Redis is not.
#HUEY_CLASS=huey.SqliteHuey
#REDIS_URL=redis://localhost:6379/0
# The database. Any URL django-environ understands.
#DATABASE_URL=postgres://codesigner:secret@db:5432/codesigner
# Uploaded datasets and models. A filesystem needs nothing here; object storage
# needs django-storages (see requirements-hosted.txt) and its own settings.
#DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage

# Origins whose form posts are accepted. Required once a TLS-terminating proxy
# is in front: without the public origin listed, every POST is refused as a CSRF
# failure. Defaults to https:// each ALLOWED_HOSTS entry, which covers the
# ordinary case.
#CSRF_TRUSTED_ORIGINS=https://codesigner.example.org

# ── Where a run executes ─────────────────────────────────────────────────────
# `local` runs the optimization in the consumer process, which is what every
# install did before there was a choice. `slurm` hands it to a cluster: the
# consumer stages the experiment, submits a job, watches it, and brings the
# result back. Independent of where the consumer itself runs.
#
# Deploy the run half first — `./cluster/deploy.sh` — and see the README.
#RUN_BACKEND=local
# A name `ssh` already understands, so the key, the user and any ProxyJump stay
# in ~/.ssh/config rather than being restated here.
#CLUSTER_HOST=kisski
# Where deploy.sh put core/ and cluster/, relative to the cluster account's home.
#CLUSTER_ROOT=codesigner
#CLUSTER_PARTITION=kisski-inference
# Cores requested, and told to the thread pools inside the job.
#CLUSTER_CPUS=8
# Wall clock a job may ask for when the run sets no limit of its own. Must not
# exceed what the partition allows, or the scheduler refuses the job.
#CLUSTER_MAX_HOURS=24
# How often the consumer asks the cluster what is happening. Also how often a
# page's figures can move, so it trades liveness against load on the login node.
#CLUSTER_POLL_SECONDS=5

# ── Background queue ─────────────────────────────────────────────────────────
# Concurrent jobs the consumer will run. More than one matters because building
# a model environment shares this queue with optimizations, and a large download
# would otherwise hold the only worker. Raise it if runs queue up behind each
# other; each concurrent run costs the memory of one model.
#HUEY_WORKERS=4
