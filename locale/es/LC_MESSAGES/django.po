msgstr "0 dibuja todas las pruebas."

#: ui/forms.py:390
msgid "0 explains every trial."
msgstr "0 explica todas las pruebas."

#: ui/forms.py:394
msgid "Share of the metric's scale a prior may fall short by."
msgstr ""
"Fracción de la escala de la métrica en la que un prior puede quedarse corto."

#: ui/forms.py:397 ui/templates/ui/figures/prior.html:154
#: ui/templates/ui/figures/prior.html:159
msgid "Best configurations compared on each side."
msgstr "Mejores configuraciones comparadas en cada lado."

#: ui/forms.py:399
msgid "Trial models kept for export"
msgstr "Modelos de las pruebas conservados para exportar"

#: ui/forms.py:400
msgid "0 keeps none."
msgstr "0 no conserva ninguno."

#: ui/forms.py:402
msgid "Also keep every trial of the last run"
msgstr "Conservar también todas las pruebas de la última ejecución"

#: ui/forms.py:403
msgid "Kept until the next run starts."
msgstr "Se conservan hasta que empieza la siguiente ejecución."

