#: ui/templates/ui/import.html:8
msgid ""
"Upload an <code>.ihpo</code> file to add it to your saved\n"
"       experiments. Optionally attach its dataset to make it runnable; "
"otherwise\n"
"       it loads read-only."
msgstr ""
"Suba un archivo <code>.ihpo</code> para añadirlo a sus experimentos "
"guardados. Opcionalmente, adjunte su conjunto de datos para poder "
"ejecutarlo; de lo contrario, se cargará en modo de solo lectura."

#: ui/templates/ui/import.html:19
msgid "Experiment file (.ihpo)"
msgstr "Archivo de experimento (.ihpo)"

#: ui/templates/ui/import.html:23
