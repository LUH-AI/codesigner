#: access/management/commands/groups.py:18
#, python-format
msgid "There is no group called “%(name)s”."
msgstr "No hay ningún grupo llamado «%(name)s»."

#: access/management/commands/members.py:21
#, python-format
msgid "%(who)s is not in %(group)s."
msgstr "%(who)s no está en %(group)s."

#: access/onboarding.py:28 ui/templates/ui/account/login.html:13
msgid "Username"
msgstr "Usuario"

#: access/onboarding.py:50
msgid "A username of 1 to 150 characters is needed."
msgstr "Se necesita un nombre de usuario de 1 a 150 caracteres."

#: access/onboarding.py:54
msgid "A username can only contain letters, digits and @ . + - _."
msgstr "Un nombre de usuario solo puede contener letras, dígitos y @ . + - _."

#: access/onboarding.py:64
#, python-format
msgid ""
"Added %(name)s to %(group)s. They choose their password the first time they "
"sign in with this username."
msgstr ""
"%(name)s se ha añadido a %(group)s. La contraseña se elige al iniciar sesión "
"por primera vez con este nombre de usuario."

#: access/onboarding.py:67
#, python-format
msgid "Added %(name)s to %(group)s."
msgstr "%(name)s se ha añadido a %(group)s."

#: access/onboarding.py:76
#, python-format
msgid "%(name)s chooses a new password the next time they sign in."
msgstr ""
"%(name)s elegirá una contraseña nueva al iniciar sesión la próxima vez."

#: access/policy.py:327
#, python-format
msgid "%(user)s is not allowed to run custom models here."
msgstr "%(user)s no puede ejecutar modelos propios aquí."

#: access/policy.py:328
msgid ""
"This experiment's custom model has no account behind it, so it cannot be run."
" Give the experiment an owner who is allowed to run custom models."
msgstr ""
"El modelo propio de este experimento no tiene ninguna cuenta detrás, así que "
"no puede ejecutarse. Asigne al experimento una persona propietaria con "
"permiso para ejecutar modelos propios."

#: access/services/groups.py:24
#, python-format
msgid "“%(who)s” is not a valid %(what)s."
msgstr "«%(who)s» no es un valor válido para: %(what)s."

#: access/services/groups.py:37
msgid "A group needs a name."
msgstr "Un grupo necesita un nombre."

#: access/services/groups.py:39 access/services/groups.py:59
#, python-format
msgid "There is already a group called “%(name)s”."
msgstr "Ya existe un grupo llamado «%(name)s»."

#: access/services/groups.py:41
msgid "A new group needs a primary lead."
msgstr "Un grupo nuevo necesita una dirección principal."

#: access/services/groups.py:43
msgid "A new group needs at least one seat, for its primary lead."
msgstr ""
"Un grupo nuevo necesita al menos una plaza, para su dirección principal."

#: access/services/groups.py:56
msgid ""
"A group needs a name, a seat limit of zero or more, and a storage limit of "
"zero or more."
msgstr ""
"Un grupo necesita un nombre, un límite de plazas de cero o más y un límite de"
" almacenamiento de cero o más."

#: access/services/groups.py:73
#, python-format
msgid "%(name)s still has people in it. Remove them first."
msgstr "%(name)s todavía tiene personas. Elimínelas primero."

#: access/services/groups.py:97
msgid "Say who to add."
msgstr "Indique a quién quiere añadir."

#: access/services/groups.py:100
#, python-format
msgid ""
"%(group)s is full: %(limit)s of %(limit)s seats used. A site admin can raise "
"the limit."
msgstr ""
"%(group)s está lleno: %(limit)s de %(limit)s plazas ocupadas. La "
"administración del sitio puede subir el límite."

#: access/services/groups.py:103
msgid "You cannot add somebody with that role."
msgstr "No puede añadir a nadie con ese rol."

#: access/services/groups.py:106
#, python-format
msgid "%(who)s is already in %(group)s."
msgstr "%(who)s ya está en %(group)s."

#: access/services/groups.py:119
msgid "You cannot remove yourself from your own group."
msgstr "No puede quitarse a sí mismo de su propio grupo."

#: access/services/groups.py:122
#, python-format
msgid ""
"%(name)s is the primary lead. The role has to be transferred before they can "
"leave."
msgstr ""
"%(name)s es la dirección principal. El rol debe transferirse antes de que "
"pueda salir."

#: access/services/groups.py:126
#, python-format
msgid ""
"%(name)s still owns experiments. Out of the group nobody could reach them — "
"reassign them first."
msgstr ""
"%(name)s todavía posee experimentos. Fuera del grupo nadie podría acceder a "
"ellos — reasígnelos primero."

#: access/services/groups.py:134
msgid ""
"You cannot change your own role. Transfer the primary lead role to somebody "
"else instead."
msgstr ""
"No puede cambiar su propio rol. Transfiera el rol de dirección principal a "
"otra persona."

#: access/services/groups.py:137
msgid "That is not a role you can set."
msgstr "Ese no es un rol que pueda asignar."

#: access/services/groups.py:146
msgid "You already hold it."
msgstr "Ya lo tiene."

#: access/services/groups.py:149
#, python-format
msgid ""
"The primary lead role can only go to a group lead. Make %(name)s a lead "
"first."
msgstr ""
"El rol de dirección principal solo puede ir a una dirección de grupo. Haga "
"primero que %(name)s sea dirección de grupo."

#: access/services/users.py:18
#, python-format
msgid "There is no account for %(who)s."
msgstr "No hay ninguna cuenta para %(who)s."

#: access/services/users.py:39
#, python-format
msgid ""
"%(who)s still owns experiments, so this account cannot be deleted. Deactivate"
" it instead, or hand the experiments to somebody else first."
msgstr ""
"%(who)s todavía tiene experimentos, así que esta cuenta no se puede eliminar."
" Desactívela en su lugar, o entregue primero los experimentos a otra persona."

