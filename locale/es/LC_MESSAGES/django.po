#: experiments/services/model_export.py:24
msgid ""
"This forecast's dataset is not on this instance, and the exported file needs "
"to know how its columns were read."
msgstr ""
"El conjunto de datos de este pronóstico no está en esta instancia, y el "
"archivo exportado necesita saber cómo se leyeron sus columnas."

#: experiments/services/model_export.py:28
msgid "This experiment's model file is missing, so there is nothing to export."
msgstr ""
"Falta el archivo del modelo de este experimento, así que no hay nada que "
"exportar."

#: experiments/services/model_export.py:32
msgid ""
"This experiment was imported without its model, so there is nothing to "
"export."
msgstr ""
"Este experimento se importó sin su modelo, así que no hay nada que exportar."

#: experiments/services/model_export.py:94
msgid "Not recorded"
msgstr "No registrado"

#: experiments/services/model_export.py:96
#, python-format
msgid "%(k)s backtest of %(h)s steps by %(column)s"
msgid_plural "%(k)s backtests of %(h)s steps by %(column)s"
msgstr[0] "%(k)s backtest de %(h)s pasos según %(column)s"
msgstr[1] "%(k)s backtests de %(h)s pasos según %(column)s"

#: experiments/services/model_export.py:102
#, python-format
msgid "%(k)s time-ordered folds by %(column)s"
msgstr "%(k)s pliegues ordenados en el tiempo según %(column)s"

#: experiments/services/model_export.py:104
#, python-format
