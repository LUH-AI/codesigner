msgstr "No se pudo leer %(name)s."

#: ui/views.py:2562
msgid "This is not a readable SMAC run."
msgstr "Esta no es una ejecución de SMAC legible."

#: ui/views.py:2622
msgid ""
"Local explanation needs the search space, which this experiment does not "
