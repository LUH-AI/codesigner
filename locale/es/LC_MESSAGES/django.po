#: datahandling/sections.py:41 ui/views.py:3001
msgid "Overview"
msgstr "Resumen"

#: datahandling/sections.py:43
msgid "Profile"
msgstr "Perfil"

#: datahandling/sections.py:43
msgid ""
"Rows, columns, size in memory, and how the file was read (separator, "
"encoding, header)."
msgstr ""
"Filas, columnas, tamaño en memoria y cómo se leyó el archivo (separador, "
"codificación, cabecera)."

#: datahandling/sections.py:45
msgid "Column kinds"
msgstr "Tipos de columna"

#: datahandling/sections.py:45
msgid ""
"Each column as numeric, categorical, datetime, text or identifier, as "
"detected."
msgstr ""
"Cada columna como numérica, categórica, fecha y hora, texto o identificador, "
"según se detectó."

#: datahandling/sections.py:47
msgid "Where values are missing"
msgstr "Dónde faltan valores"

#: datahandling/sections.py:47
msgid "How much of each column is empty, and where."
msgstr "Qué parte de cada columna está vacía, y dónde."

#: datahandling/sections.py:48
msgid "Target distribution"
msgstr "Distribución del objetivo"

#: datahandling/sections.py:48
msgid ""
"Class counts for classification, a histogram for regression, the series "
"itself for forecasting."
msgstr ""
"Recuento de clases para clasificación, un histograma para regresión, la "
"propia serie para pronóstico."

#: datahandling/sections.py:50
msgid "Sample"
msgstr "Muestra"

#: datahandling/sections.py:50
msgid "The first rows, a random sample, and the rows that look unusual."
msgstr ""
"Las primeras filas, una muestra aleatoria y las filas que parecen inusuales."

#: datahandling/sections.py:55
msgid "Columns"
msgstr "Columnas"

#: datahandling/sections.py:57
msgid "Target"
msgstr "Objetivo"

#: datahandling/sections.py:57
msgid "Choose the column to predict, rather than it having to be the last."
msgstr ""
"Elegir la columna que se va a predecir, en vez de que tenga que ser la "
"última."

#: datahandling/sections.py:59
msgid "Kinds"
msgstr "Tipos"

#: datahandling/sections.py:59
msgid ""
"Override a detected kind: numeric, categorical, datetime, free text, "
"identifier, or ignored."
msgstr ""
"Cambiar un tipo detectado: numérico, categórico, fecha y hora, texto libre, "
"identificador o ignorado."

#: datahandling/sections.py:61
msgid "Rename and drop"
msgstr "Renombrar y descartar"

#: datahandling/sections.py:61
msgid ""
"Give columns readable names; leave out the ones that should not be features."
msgstr ""
"Dar a las columnas nombres legibles; dejar fuera las que no deberían ser "
"atributos."

#: datahandling/sections.py:63
msgid "Roles"
msgstr "Roles"

#: datahandling/sections.py:63
msgid ""
"Mark the time column, the series identifier for many series in one file, and "
"the group column for grouped splits."
msgstr ""
"Marcar la columna de tiempo, el identificador de serie cuando hay muchas "
"series en un archivo y la columna de grupo para divisiones agrupadas."

#: datahandling/sections.py:65
msgid "Known in the future"
msgstr "Conocidos de antemano"

#: datahandling/sections.py:65
msgid ""
"For forecasting: which features are known ahead of time (a holiday calendar) "
"and which only up to now (yesterday's sales)."
msgstr ""
"Para pronóstico: qué atributos se conocen de antemano (un calendario de "
"festivos) y cuáles solo hasta ahora (las ventas de ayer)."

#: datahandling/sections.py:71
msgid "Quality"
msgstr "Calidad"

#: datahandling/sections.py:73
msgid "Missing-value patterns"
msgstr "Patrones de valores faltantes"

#: datahandling/sections.py:73
msgid "Whether gaps are random or cluster in certain rows, columns or classes."
msgstr ""
"Si los huecos son aleatorios o se concentran en ciertas filas, columnas o "
"clases."

#: datahandling/sections.py:75
msgid "Duplicates"
msgstr "Duplicados"

#: datahandling/sections.py:75
msgid ""
"Exact and near-duplicate rows, and duplicates that disagree on the target."
msgstr ""
"Filas duplicadas exactas y casi duplicadas, y duplicados que discrepan en el "
"objetivo."

#: datahandling/sections.py:77
msgid "Constant columns"
msgstr "Columnas constantes"

#: datahandling/sections.py:77
msgid "Columns with one value, or nearly so, which carry no information."
msgstr "Columnas con un solo valor, o casi, que no aportan información."

#: datahandling/sections.py:79
msgid "Outliers"
msgstr "Valores atípicos"

#: datahandling/sections.py:79
msgid "Values far from the rest of their column, per column and jointly."
msgstr "Valores alejados del resto de su columna, por columna y en conjunto."

#: datahandling/sections.py:81
msgid "Class imbalance"
msgstr "Desequilibrio de clases"

#: datahandling/sections.py:81
msgid ""
"How rare the rarest class is, and what that does to accuracy as a metric."
msgstr ""
"Lo rara que es la clase más rara, y lo que eso supone para la exactitud como "
"métrica."

#: datahandling/sections.py:83
msgid "Label noise"
msgstr "Ruido en las etiquetas"

#: datahandling/sections.py:83
msgid "Rows whose target disagrees with their nearest neighbours'."
msgstr "Filas cuyo objetivo discrepa del de sus vecinos más cercanos."

#: datahandling/sections.py:85
msgid "Target leakage"
msgstr "Fuga del objetivo"

#: datahandling/sections.py:85
msgid ""
"Features that predict the target suspiciously well — an identifier, or "
"something recorded after the fact."
msgstr ""
"Atributos que predicen el objetivo sospechosamente bien — un identificador, "
"o algo registrado a posteriori."

#: datahandling/sections.py:87
msgid "Train and test overlap"
msgstr "Solapamiento entre entrenamiento y test"

#: datahandling/sections.py:87
msgid "The same row on both sides of a split, which flatters every score."
msgstr ""
"La misma fila a ambos lados de una división, lo que favorece toda puntuación."

#: datahandling/sections.py:92
msgid "Cleaning"
msgstr "Limpieza"

#: datahandling/sections.py:94 ui/timeline.py:27
msgid "Missing values"
msgstr "Valores faltantes"

#: datahandling/sections.py:94
msgid ""
"Fill each gap in — a number with its column's median, a label with its "
"commonest label — or leave it for the model. A model that cannot take a gap "
"always has its gaps filled."
msgstr ""
"Rellenar cada hueco — un número con la mediana de su columna, una etiqueta "
"con su etiqueta más común — o dejarlo al modelo. A un modelo que no admite "
"huecos siempre se le rellenan."

#: datahandling/sections.py:98
msgid "Imputation"
msgstr "Imputación"

#: datahandling/sections.py:98
msgid "Fill gaps with a column's mean, a constant, or from the nearest rows."
msgstr ""
"Rellenar huecos con la media de una columna, una constante o a partir de las "
"filas más cercanas."

#: datahandling/sections.py:100
msgid "Drop rows or columns"
msgstr "Descartar filas o columnas"

#: datahandling/sections.py:100
msgid ""
"Leave out rows or columns over a threshold of missing values, or by hand."
msgstr ""
"Dejar fuera las filas o columnas que superen un umbral de valores faltantes, "
"o a mano."

#: datahandling/sections.py:102
msgid "De-duplication"
msgstr "Eliminación de duplicados"

#: datahandling/sections.py:102
msgid "Keep one of each duplicate, or none of those that disagree."
msgstr "Conservar uno de cada duplicado, o ninguno de los que discrepan."

#: datahandling/sections.py:104
msgid "Outlier handling"
msgstr "Tratamiento de valores atípicos"

#: datahandling/sections.py:104
msgid "Clip to a percentile range, or remove."
msgstr "Recortar a un rango de percentiles, o eliminar."

#: datahandling/sections.py:105
msgid "Type coercion"
msgstr "Conversión de tipos"

#: datahandling/sections.py:105
msgid "Read numbers written as text, dates in a given format, decimal commas."
msgstr ""
"Leer números escritos como texto, fechas en un formato dado, comas decimales."

#: datahandling/sections.py:107
msgid "Value mapping"
msgstr "Mapeo de valores"

#: datahandling/sections.py:107
msgid "Merge spellings of one category; group rare categories into \"other\"."
msgstr ""
"Unificar las grafías de una categoría; agrupar las categorías raras en "
"«otras»."

#: datahandling/sections.py:112
msgid "Features"
msgstr "Atributos"

#: datahandling/sections.py:114 ui/timeline.py:28
msgid "Label columns"
msgstr "Columnas de etiquetas"

#: datahandling/sections.py:114
msgid ""
"One column per label, or the labels as categories of their own for a model "
"that takes them so — codes for a booster, words for CatBoost."
msgstr ""
"Una columna por etiqueta, o las etiquetas como categorías propias para un "
"modelo que las acepta así — códigos para un booster, palabras para CatBoost."

#: datahandling/sections.py:117 ui/timeline.py:27
msgid "Scaling"
msgstr "Escalado"

#: datahandling/sections.py:117
msgid ""
"Standardize the numbers — zero mean, unit variance — for a model that "
"measures distances, or leave them as they are."
msgstr ""
"Estandarizar los números — media cero, varianza unidad — para un modelo que "
"mide distancias, o dejarlos como están."

#: datahandling/sections.py:120
msgid "Encodings"
msgstr "Codificaciones"

#: datahandling/sections.py:120
msgid "Ordinal, target or frequency encoding for categorical columns."
msgstr ""
"Codificación ordinal, por objetivo o por frecuencia para columnas "
"categóricas."

#: datahandling/sections.py:122
msgid "Other scaling"
msgstr "Otros escalados"

#: datahandling/sections.py:122
msgid "Min-max or robust scaling."
msgstr "Escalado min-max o robusto."

#: datahandling/sections.py:123
msgid "Transforms"
msgstr "Transformaciones"

#: datahandling/sections.py:123
msgid "Log, Box-Cox or Yeo-Johnson; binning a numeric column into ranges."
msgstr ""
"Log, Box-Cox o Yeo-Johnson; discretizar una columna numérica en rangos."

#: datahandling/sections.py:125
msgid "Calendar features"
msgstr "Atributos de calendario"

#: datahandling/sections.py:125
msgid "Year, month, weekday, hour, holidays from a datetime column."
msgstr ""
"Año, mes, día de la semana, hora y festivos a partir de una columna de fecha "
"y hora."

#: datahandling/sections.py:127
msgid "Interactions"
msgstr "Interacciones"

#: datahandling/sections.py:127
msgid "Products, ratios and polynomial features of chosen columns."
msgstr "Productos, cocientes y atributos polinómicos de las columnas elegidas."

#: datahandling/sections.py:129
msgid "Lags and windows"
msgstr "Retardos y ventanas"

#: datahandling/sections.py:129
msgid "Earlier values and rolling statistics, for data ordered in time."
msgstr ""
"Valores anteriores y estadísticas móviles, para datos ordenados en el tiempo."

#: datahandling/sections.py:131
msgid "Feature selection"
msgstr "Selección de atributos"

#: datahandling/sections.py:131
msgid ""
"Keep the most informative columns by importance, correlation or mutual "
"information."
msgstr ""
"Conservar las columnas más informativas según importancia, correlación o "
"información mutua."

#: datahandling/sections.py:136
msgid "Augmentation"
msgstr "Aumento de datos"

#: datahandling/sections.py:138
msgid "Resampling"
msgstr "Remuestreo"

#: datahandling/sections.py:138
msgid "Oversample rare classes or undersample common ones."
msgstr "Sobremuestrear las clases raras o submuestrear las comunes."

#: datahandling/sections.py:139
msgid "SMOTE"
msgstr "SMOTE"

#: datahandling/sections.py:139
msgid "Synthetic rows between neighbours of a rare class."
msgstr "Filas sintéticas entre vecinos de una clase rara."

#: datahandling/sections.py:140
msgid "Noise injection"
msgstr "Inyección de ruido"

#: datahandling/sections.py:140
msgid "Small perturbations of numeric features."
msgstr "Pequeñas perturbaciones de los atributos numéricos."

#: datahandling/sections.py:141
msgid "Mixup"
