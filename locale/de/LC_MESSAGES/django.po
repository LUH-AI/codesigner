msgstr "Verbesserungswahrscheinlichkeit"

#: ui/optimizer_labels.py:168
msgid "Vanilla"
msgstr "Vanilla"

#: ui/optimizer_labels.py:169
msgid "MCMC (slow)"
msgstr "MCMC (langsam)"

