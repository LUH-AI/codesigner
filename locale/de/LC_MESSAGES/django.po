#: ui/templates/ui/purge_confirm.html:8
#, python-format
msgid ""
"<strong>%(name)s</strong> (<code>%(ref)s</code>) and every run in it will be "
"destroyed, and it will leave everybody's bin. This cannot be undone."
msgstr ""
"<strong>%(name)s</strong> (<code>%(ref)s</code>) und jeder Lauf darin werden "
"vernichtet, und es verschwindet aus allen Papierkörben. Das lässt sich nicht "
"rückgängig machen."

#: ui/templates/ui/purge_confirm.html:12
msgid "Download .ihpo first"
msgstr "Zuerst .ihpo herunterladen"

#: ui/templates/ui/save_as_default_confirm.html:4
#: ui/templates/ui/save_as_default_confirm.html:23
msgid "Save as default"
msgstr "Als Standard speichern"

#: ui/templates/ui/save_as_default_confirm.html:5
msgid "Make these the default settings?"
msgstr "Diese zu den Standardeinstellungen machen?"

#: ui/templates/ui/save_as_default_confirm.html:8
msgid ""
"These settings become the defaults for every experiment that\n"
"    uses them, including existing ones. Experiments with their own settings "
"are\n"
"    unaffected."
msgstr ""
"Diese Einstellungen werden zum Standard für jedes Experiment, das\n"
"    sie verwendet, auch für bestehende. Experimente mit eigenen "
"Einstellungen bleiben\n"
"    unberührt."

