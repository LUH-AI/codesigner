msgid "Expected improvement"
msgstr "Erwartete Verbesserung"

#: ui/optimizer_labels.py:171
msgid "Probability of improvement"
msgstr "Verbesserungswahrscheinlichkeit"

#: ui/optimizer_labels.py:174
msgid "Vanilla"
msgstr "Vanilla"

#: ui/optimizer_labels.py:175
msgid "MCMC (slow)"
msgstr "MCMC (langsam)"

