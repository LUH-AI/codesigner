#: access/management/commands/groups.py:18
#, python-format
msgid "There is no group called “%(name)s”."
msgstr "Es gibt keine Gruppe namens „%(name)s“."

#: access/management/commands/members.py:21
#, python-format
msgid "%(who)s is not in %(group)s."
msgstr "%(who)s ist nicht in %(group)s."

#: access/models.py:100 access/services/groups.py:80
#: access/services/groups.py:81
msgid "Member"
msgstr "Mitglied"

#: access/models.py:100 access/services/groups.py:80
msgid "Group lead"
msgstr "Gruppenleitung"

#: access/models.py:101
msgid "Primary group lead"
msgstr "Hauptleitung"

#: access/onboarding.py:26 ui/templates/ui/account/login.html:13
msgid "Email address"
msgstr "E-Mail-Adresse"

#: access/onboarding.py:46
#, python-format
msgid ""
"Added %(name)s to %(group)s. They choose their password the first time they "
"sign in with this email address."
msgstr ""
"%(name)s wurde zu %(group)s hinzugefügt. Das Passwort wird bei der ersten "
"Anmeldung mit dieser E-Mail-Adresse gewählt."

#: access/onboarding.py:49
#, python-format
msgid "Added %(name)s to %(group)s."
msgstr "%(name)s wurde zu %(group)s hinzugefügt."

#: access/onboarding.py:58
#, python-format
msgid "%(name)s chooses a new password the next time they sign in."
msgstr "%(name)s wählt bei der nächsten Anmeldung ein neues Passwort."

#: access/policy.py:330
#, python-format
msgid "%(user)s is not allowed to run custom models here."
msgstr "%(user)s darf hier keine eigenen Modelle ausführen."

#: access/policy.py:331
msgid ""
"This experiment's custom model has no account behind it, so it cannot be "
"run. Give the experiment an owner who is allowed to run custom models."
msgstr ""
"Das eigene Modell dieses Experiments hat kein Konto hinter sich und kann "
"daher nicht ausgeführt werden. Geben Sie dem Experiment eine Eigentümerin "
"oder einen Eigentümer mit der Berechtigung, eigene Modelle auszuführen."

#: access/services/groups.py:24
#, python-format
msgid "“%(who)s” is not a valid %(what)s."
msgstr "„%(who)s“ ist kein gültiger Wert für: %(what)s."

#: access/services/groups.py:37
msgid "A group needs a name."
msgstr "Eine Gruppe braucht einen Namen."

#: access/services/groups.py:39 access/services/groups.py:59
#, python-format
msgid "There is already a group called “%(name)s”."
msgstr "Es gibt bereits eine Gruppe namens „%(name)s“."

#: access/services/groups.py:41
msgid "A new group needs a primary lead."
msgstr "Eine neue Gruppe braucht eine Hauptleitung."

#: access/services/groups.py:43
msgid "A new group needs at least one seat, for its primary lead."
msgstr ""
"Eine neue Gruppe braucht mindestens einen Platz, für ihre Hauptleitung."

#: access/services/groups.py:56
msgid ""
"A group needs a name, a seat limit of zero or more, and a storage limit of "
"zero or more."
msgstr ""
"Eine Gruppe braucht einen Namen, eine Platzgrenze von null oder mehr und "
"eine Speichergrenze von null oder mehr."

#: access/services/groups.py:73
#, python-format
msgid "%(name)s still has people in it. Remove them first."
msgstr "In %(name)s sind noch Personen. Entfernen Sie sie zuerst."

#: access/services/groups.py:97
msgid "Say who to add."
msgstr "Geben Sie an, wen Sie hinzufügen möchten."

#: access/services/groups.py:100
#, python-format
msgid ""
"%(group)s is full: %(limit)s of %(limit)s seats used. A site admin can raise "
"the limit."
msgstr ""
"%(group)s ist voll: %(limit)s von %(limit)s Plätzen belegt. Eine "
"Instanzadministratorin oder ein Instanzadministrator kann die Grenze anheben."

#: access/services/groups.py:103
msgid "You cannot add somebody with that role."
msgstr "Sie können niemanden mit dieser Rolle hinzufügen."

#: access/services/groups.py:106
#, python-format
msgid "%(who)s is already in %(group)s."
msgstr "%(who)s ist bereits in %(group)s."

#: access/services/groups.py:119
msgid "You cannot remove yourself from your own group."
msgstr "Sie können sich nicht selbst aus Ihrer eigenen Gruppe entfernen."

#: access/services/groups.py:122
#, python-format
msgid ""
"%(name)s is the primary lead. The role has to be transferred before they can "
"leave."
msgstr ""
"%(name)s ist die Hauptleitung. Die Rolle muss übertragen werden, bevor diese "
"Person die Gruppe verlassen kann."

#: access/services/groups.py:126
#, python-format
msgid ""
"%(name)s still owns experiments. Out of the group nobody could reach them — "
"reassign them first."
msgstr ""
"%(name)s besitzt noch Experimente. Außerhalb der Gruppe käme niemand an sie "
"heran — weisen Sie sie zuerst neu zu."

#: access/services/groups.py:134
msgid ""
"You cannot change your own role. Transfer the primary lead role to somebody "
"else instead."
msgstr ""
"Sie können Ihre eigene Rolle nicht ändern. Übertragen Sie stattdessen die "
"Rolle der Hauptleitung an jemand anderen."

#: access/services/groups.py:137
msgid "That is not a role you can set."
msgstr "Das ist keine Rolle, die Sie setzen können."

#: access/services/groups.py:146
msgid "You already hold it."
msgstr "Sie haben sie bereits."

#: access/services/groups.py:149
#, python-format
msgid ""
"The primary lead role can only go to a group lead. Make %(name)s a lead "
"first."
msgstr ""
"Die Rolle der Hauptleitung kann nur an eine Gruppenleitung gehen. Machen Sie "
"%(name)s zuerst zur Gruppenleitung."

#: access/services/users.py:23
#, python-format
msgid "There is no account for %(who)s."
msgstr "Es gibt kein Konto für %(who)s."

#: access/services/users.py:66
#, python-format
msgid "A display name needs at least %(n)s characters."
msgstr "Ein Anzeigename braucht mindestens %(n)s Zeichen."

#: access/services/users.py:86
#, python-format
msgid ""
"%(who)s still owns experiments, so this account cannot be deleted. "
"Deactivate it instead, or hand the experiments to somebody else first."
msgstr ""
"%(who)s besitzt noch Experimente, daher kann dieses Konto nicht gelöscht "
"werden. Deaktivieren Sie es stattdessen, oder übergeben Sie die Experimente "
"zuerst an jemand anderen."

#: access/services/users.py:107
#, python-format
msgid ""
"%(who)s is the primary lead of %(groups)s. Make somebody else primary lead "
"first."
msgstr ""
"%(who)s ist die Hauptleitung von %(groups)s. Machen Sie zuerst jemand "
"anderen zur Hauptleitung."

#: access/services/users.py:191
#, python-format
msgid "%(address)s is not an email address."
msgstr "%(address)s ist keine E-Mail-Adresse."

#: access/services/users.py:197
#, python-format
msgid "Another account already uses %(address)s."
msgstr "Ein anderes Konto verwendet bereits %(address)s."

